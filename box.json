{
    "name":"FormUtilities",
    "version":"2.1.1",
    "location":"ForgeboxStorage",
    "author":"Francesco Pepe",
    "slug":"formutilities",
    "type":"modules",
    "keywords":"form, form utilities",
    "homepage":"https://github.com/Tropicalista/FormUtilities",
    "documentation":"https://github.com/Tropicalista/FormUtilities",
    "repository":{
        "type":"git",
        "url":"https://github.com/Tropicalista/FormUtilities"
    },
    "bugs":"https://github.com/Tropicalista/FormUtilities/issues",
    "shortDescription":"A coldbox module that wrap Brian Kotek form utilities plugin",
    "ignore":[
        "**/.*",
        "testbox",
        "tests",
        "/server*.json",
        "build"
    ],
    "scripts":{
        "build:module":"task run taskFile=build/Build.cfc :projectName=`package show slug` :version=`package show version`",
        "onRelease":"publish",
        "postPublish":"!git push --follow-tags"
    },
    "dependencies":{},
    "installPaths":{
        "testbox":"testbox/"
    },
    "devDependencies":{
        "testbox":"^5.4.0+7"
    }
}
